{
  "name": "@conu/sdk",
  "version": "0.1.5",
  "description": "Dependency-free Node.js SDK wrapper for local conU CLI, conUD, and conU MCP binaries.",
  "homepage": "https://github.com/imthegoodboy/conU#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imthegoodboy/conU.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/imthegoodboy/conU/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "browser": "./src/browser.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./src/browser.d.ts",
        "default": "./src/browser.js"
      },
      "node": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/browser.js && node --check ../../examples/typescript/local_agent_pair.mjs && node test/smoke.mjs"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
